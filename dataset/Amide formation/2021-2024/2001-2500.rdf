(125 MHz, CDCl3): δ = 170.8, 135.9, 135.1, 133.7, 133.6, 132.4, 131.7,
131.5, 131.4, 129.8, 129.6, 128.6, 128.5, 127.9, 127.7, 127.4, 126.7,
